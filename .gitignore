.DS_Store
.AppleDouble
.LSOverride

# Env — never commit real .env files; the template IS committed so others know what to fill in
.env
.env.*
!.env.example

# Credentials & keys — never commit
.secret
*.pem
*.key
*-key.json
config/sa-key.json
service-account*.json
credentials*.json
sa.json
gcloud-*.json

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Node
node_modules/

# Logs
*.log

# Local data — never commit (real inbox content, contact DBs, watermarks)
config/settings.json
# The gazetteer names your real clients/suppliers — keep it OUT of git (config/gazetteer.example.csv
# is the committed template). It is bind-mounted/read at runtime, so the local file stays on disk.
config/gazetteer.csv
labels/*.csv
corpus/*.eml
*.db
*.sqlite
*.sqlite3
# SQLite WAL sidecars (workspace.db runs in WAL mode; the intake worker is a 2nd writer — ADR-021).
# `*.db` is matched literally, so the -wal/-shm siblings need their own globs. (out/* already covers the
# real out/workspace.db-* pair; these guard a db opened elsewhere, e.g. a stray root-level copy.)
*.db-wal
*.db-shm
# Conversational-intake media (ADR-020): PRECIOUS sole-copy photos/audio — never committed; it lives
# in the backup set instead (see docs/05-reference/data-stores.md). The intake worker writes here.
captures/
# out/ holds personal data (subjects, addresses, bodies, contact DB) + the regenerable intake offset
# cursor (out/intake_offset.json) — ignore all but the keep file
out/*
!out/.gitkeep

# Local app screenshots — they capture REAL inbox content (subjects, addresses, message-ids in the
# filename). Never commit. Sanitized UI shots, if ever needed, go under docs/ and are force-added.
res/screenshots/

# Python build artifacts
*.egg-info/

# Verified snapshots of the precious stores (bin/backup-workspace.sh).
# Personal data — never committed, even if a future snapshot adds non-.db files.
backups/

# Self-signed TLS material (bin/make-cert.sh). A private key must never be committed.
certs/

# Browser-automation artifacts (Playwright MCP) and ad-hoc UI screenshots. These are snapshots of
# the RUNNING app, so they carry real client names, addresses and subject lines — the same personal
# data as out/. The repo is public; a screenshot leaks exactly what results.jsonl is ignored to protect.
.playwright-mcp/
/*.png
